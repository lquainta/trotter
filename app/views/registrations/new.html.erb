<% content_for :title, "Sign up · Trotter" %>

<div class="mx-auto max-w-sm">
  <h1 class="text-2xl font-bold">Create your account</h1>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= form.label :username, class: "form-label" %>
      <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", minlength: 3, maxlength: 20,
            pattern: "[A-Za-z0-9_]+", title: "Letters, numbers, and underscores only", class: "form-input" %>
      <p class="form-hint">3–20 letters, numbers, or underscores.</p>
    </div>

    <div>
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "form-input" %>
      <p class="form-hint">At least 8 characters.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "form-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-input" %>
    </div>

    <%= form.submit "Create account", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-stone-600 dark:text-stone-400">
    Already have an account? <%= link_to "Log in", new_session_path, class: "font-medium text-amber-800 underline dark:text-amber-400" %>
  </p>
</div>
