<% content_for :title, "Search · Trotter" %>

<h1 class="text-2xl font-bold">Search rides</h1>
<p class="mt-1 text-stone-600 dark:text-stone-300">Find rides by keyword, rider, horse, distance, date, or photos.</p>

<%= form_with url: search_path, method: :get, html: { role: "search", aria: { label: "Search rides" } }, class: "card mt-6 space-y-5 p-6" do |form| %>
  <div>
    <%= form.label :q, "Keyword", class: "form-label" %>
    <%= form.search_field :q, value: @search.keyword, maxlength: 100, placeholder: "foothills, creek, arena…", class: "form-input" %>
    <p class="form-hint">Matches words in a ride's title or description.</p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :rider, class: "form-label" %>
      <%= form.text_field :rider, value: @search.rider, maxlength: 20, placeholder: "username", autocapitalize: "none",
            spellcheck: false, class: "form-input" %>
    </div>
    <div>
      <%= form.label :horse_id, "Horse", class: "form-label" %>
      <%= form.select :horse_id,
            grouped_options_for_select(@horses.group_by { |horse| horse.user.username }.sort.map { |username, horses|
              [ "#{username}'s horses", horses.map { |horse| [ horse.name, horse.id ] } ] }, @search.horse_id),
            { include_blank: "Any horse" }, class: "form-input" %>
    </div>
  </div>

  <div class="grid gap-5">
    <fieldset>
      <legend class="form-label">Distance (<%= @search.unit %>)</legend>
      <div class="flex max-w-md items-center gap-2">
        <%= form.label :min_distance, "Minimum distance", class: "sr-only" %>
        <%= form.number_field :min_distance, value: @search.min_distance, min: 0, step: "any", placeholder: "Min",
              class: "form-input min-w-0 tabular-nums" %>
        <span class="mt-1 text-stone-500" aria-hidden="true">to</span>
        <%= form.label :max_distance, "Maximum distance", class: "sr-only" %>
        <%= form.number_field :max_distance, value: @search.max_distance, min: 0, step: "any", placeholder: "Max",
              class: "form-input min-w-0 tabular-nums" %>
      </div>
    </fieldset>
    <fieldset>
      <legend class="form-label">Date</legend>
      <div class="flex max-w-md items-center gap-2">
        <%= form.label :from, "From date", class: "sr-only" %>
        <%= form.date_field :from, value: @search.from, class: "form-input min-w-0 tabular-nums" %>
        <span class="mt-1 text-stone-500" aria-hidden="true">to</span>
        <%= form.label :to, "To date", class: "sr-only" %>
        <%= form.date_field :to, value: @search.to, class: "form-input min-w-0 tabular-nums" %>
      </div>
    </fieldset>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <label class="flex items-center gap-2 text-sm font-medium">
      <%= form.check_box :photos, { checked: @search.photos, class: "size-4 accent-amber-700" }, "1", nil %>
      Only rides with photos
    </label>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <%= form.label :sort, "Sort", class: "form-label" %>
        <%= form.select :sort, ActivitySearch::SORT_LABELS.invert, { selected: @search.sort }, class: "form-input" %>
      </div>
      <%= form.submit "Search", name: nil, class: "btn-primary" %>
      <%= link_to "Clear", search_path, class: "btn-secondary px-4 py-2 text-base" %>
    </div>
  </div>
<% end %>

<% if !@search.filtered? %>
  <section id="search-prompt" class="mt-6 rounded-lg border border-dashed border-stone-300 px-6 py-8 text-stone-600 dark:border-stone-700 dark:text-stone-300">
    <h2 class="font-semibold text-stone-900 dark:text-stone-100">Set at least one filter to search</h2>
    <p class="mt-1 text-sm">Fill in any of the fields above and choose Search. Results come 10 at a time. Try one of these:</p>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm">
      <% [ [ "Rides mentioning “hack”", { q: "hack" } ],
           [ "Longest rides over 3 #{@search.unit}", { min_distance: 3, sort: "longest" } ],
           [ "Rides from the last week", { from: 7.days.ago.to_date.iso8601 } ],
           [ "Rides with photos", { photos: "1" } ] ].each do |label, example| %>
        <li><%= link_to label, search_path(example), class: "btn-secondary" %></li>
      <% end %>
    </ul>
  </section>
<% elsif @search.total_count.zero? %>
  <p id="search-results" class="mt-6 rounded-lg border border-dashed border-stone-300 px-4 py-10 text-center text-stone-500 dark:border-stone-700 dark:text-stone-400">
    No rides match that search.
  </p>
<% else %>
  <section id="search-results" class="mt-6" aria-labelledby="search-results-heading">
    <h2 id="search-results-heading" class="text-sm text-stone-600 dark:text-stone-300">
      <% if @search.results.empty? %>
        No more results. There <%= @search.total_count == 1 ? "is" : "are" %> <%= pluralize(@search.total_count, "ride") %> in all.
      <% else %>
        Showing <%= @search.first_position %>–<%= @search.last_position %> of <%= pluralize(@search.total_count, "ride") %>
      <% end %>
    </h2>

    <ol class="mt-3 space-y-3">
      <% @search.results.each do |activity| %>
        <li id="<%= dom_id(activity, :result) %>" class="card flex gap-4 p-3">
          <%= link_to activity_path(activity), tabindex: -1, aria: { hidden: true } do %>
            <%= route_outline activity.route_coordinates, label: "Route outline of #{activity.title}" %>
          <% end %>
          <div class="min-w-0 flex-1">
            <h3 class="truncate font-semibold"><%= link_to activity.title, activity_path(activity), class: "hover:underline" %></h3>
            <p class="truncate text-sm text-stone-500 dark:text-stone-400">
              <%= link_to activity.user.username, user_path(activity.user), class: "font-medium text-stone-700 hover:underline dark:text-stone-200" %>
              &middot; <%= activity.started_at.strftime("%b %-d, %Y") %>
              <% if activity.horse %>
                &middot; on <%= link_to activity.horse.name, horse_path(activity.horse), class: "font-medium text-amber-800 hover:underline dark:text-amber-400" %>
              <% end %>
            </p>
            <p class="mt-1 text-sm tabular-nums">
              <span class="font-semibold"><%= format_distance(activity.distance_meters) %></span>
              &middot; <%= format_duration(activity.duration) %>
              &middot; <%= format_speed(activity.distance_meters, activity.duration) %>
              <% if activity.photos.attached? %>
                &middot; <span title="Photos">📷 <%= activity.photos.size %></span>
              <% end %>
            </p>
          </div>
        </li>
      <% end %>
    </ol>

    <% if @search.total_pages > 1 %>
      <nav aria-label="Search results pages" class="mt-4 flex items-center justify-between gap-4 text-sm">
        <% if @search.previous_page %>
          <%= link_to "← Previous", search_path(@search.to_params(page: @search.previous_page)), rel: "prev", class: "btn-secondary" %>
        <% else %>
          <span></span>
        <% end %>
        <span class="text-stone-500 dark:text-stone-400">Page <%= @search.page %> of <%= @search.total_pages %></span>
        <% if @search.next_page %>
          <%= link_to "Next →", search_path(@search.to_params(page: @search.next_page)), rel: "next", class: "btn-secondary" %>
        <% else %>
          <span></span>
        <% end %>
      </nav>
    <% end %>
  </section>
<% end %>
