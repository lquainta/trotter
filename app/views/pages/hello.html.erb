<!DOCTYPE html>
<html>
  <head>
    <title>Trotter</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      html, body { height: 100%; overflow: hidden; }

      body {
        background: radial-gradient(ellipse at 50% 120%, #ff2bd6 0%, #7b1fa2 30%, #1a0638 60%, #05010f 100%);
        color: #fff;
        font-family: "Trebuchet MS", "Arial Black", system-ui, sans-serif;
        cursor: crosshair;
      }

      /* ---- stars ---- */
      .stars { position: fixed; inset: 0; pointer-events: none; }
      .star {
        position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #fff;
        animation: twinkle var(--t) ease-in-out infinite alternate;
      }
      @keyframes twinkle { from { opacity: .15; } to { opacity: 1; box-shadow: 0 0 6px #fff; } }

      /* ---- synthwave sun ---- */
      .sun {
        position: fixed; left: 50%; bottom: 38vh; width: 38vmin; height: 38vmin; translate: -50% 50%;
        border-radius: 50%;
        background: linear-gradient(#ffe259 0%, #ff8c42 45%, #ff2bd6 100%);
        box-shadow: 0 0 60px #ff2bd6, 0 0 140px #ff8c42;
        /* Solid top half, horizontal stripes on the bottom half, like an 80s sunset. */
        mask: linear-gradient(#000 0 52%, transparent 52%), repeating-linear-gradient(#000 0 9px, transparent 9px 14px);
        mask-composite: add;
        animation: sunpulse 4s ease-in-out infinite;
      }
      @keyframes sunpulse { 50% { box-shadow: 0 0 90px #ff2bd6, 0 0 200px #ffb347; } }

      /* ---- retro grid floor ---- */
      .floor {
        position: fixed; left: -50%; right: -50%; bottom: 0; height: 40vh;
        background:
          linear-gradient(transparent 0 96%, #ff2bd6 96%) 0 0 / 100% 40px,
          linear-gradient(90deg, transparent 0 97%, #00f0ff 97%) 0 0 / 60px 100%;
        transform: perspective(300px) rotateX(60deg);
        transform-origin: bottom;
        animation: drive 1.2s linear infinite;
        filter: drop-shadow(0 0 4px #ff2bd6);
        opacity: .85;
      }
      .floor::after {
        content: ""; position: absolute; inset: 0;
        background: linear-gradient(#05010f 0%, transparent 60%);
      }
      @keyframes drive { to { background-position: 0 40px, 0 0; } }

      /* ---- sweeping spotlights ---- */
      .beam {
        position: fixed; bottom: -10vh; width: 18vmax; height: 140vh; pointer-events: none;
        background: linear-gradient(to top, var(--c), transparent 85%);
        clip-path: polygon(45% 100%, 55% 100%, 100% 0, 0 0);
        mix-blend-mode: screen; opacity: .35; filter: blur(6px);
        transform-origin: 50% 100%;
        animation: sweep var(--d) ease-in-out infinite alternate;
      }
      .beam.b1 { left: 8%;  --c: #00f0ff; --d: 5s; }
      .beam.b2 { left: 42%; --c: #ff2bd6; --d: 6.5s; animation-delay: -2s; }
      .beam.b3 { right: 8%; --c: #b6ff00; --d: 5.8s; animation-delay: -4s; }
      @keyframes sweep { from { rotate: -28deg; } to { rotate: 28deg; } }

      /* ---- neon headline ---- */
      .stage {
        position: fixed; inset: 0; display: grid; place-items: center; pointer-events: none;
      }
      h1 {
        font-size: clamp(3rem, 12vw, 10rem); font-weight: 900; letter-spacing: .06em; text-transform: uppercase;
        text-align: center; line-height: 1; translate: 0 -8vh;
        color: #fff6fe;
        text-shadow:
          0 0 4px #fff, 0 0 10px #ff2bd6, 0 0 22px #ff2bd6, 0 0 44px #ff2bd6,
          0 0 80px #b400ff, 0 0 120px #b400ff;
        animation: flicker 5s infinite, hue 12s linear infinite, float 3s ease-in-out infinite;
      }
      @keyframes flicker {
        0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
        20%, 24%, 55% { opacity: .35; text-shadow: none; }
      }
      @keyframes hue { to { filter: hue-rotate(360deg); } }
      @keyframes float { 50% { translate: 0 -10vh; } }

      /* ---- bouncing things ---- */
      .bouncer { position: fixed; left: 0; top: 0; will-change: transform; pointer-events: none; }
      .shape {
        width: 54px; height: 54px; display: grid; place-items: center;
        font-size: 40px; line-height: 1;
        color: var(--glow);
        text-shadow: 0 0 8px var(--glow), 0 0 22px var(--glow), 0 0 40px var(--glow);
        animation: spin 4s linear infinite;
      }
      @keyframes spin { to { rotate: 360deg; } }

      /* ---- the horse ---- */
      .horse { width: 170px; height: 190px; filter: drop-shadow(0 0 14px #00f0ff) drop-shadow(0 0 30px #ff2bd6); }
      .horse svg { width: 100%; height: 100%; overflow: visible; }
      .horse .dance { transform-box: fill-box; transform-origin: 50% 100%; animation: groove .5s ease-in-out infinite alternate; }
      .horse .head  { transform-box: fill-box; transform-origin: 50% 90%; animation: bob .25s ease-in-out infinite alternate; }
      .horse .arm-l { transform-box: fill-box; transform-origin: 90% 10%; animation: wave-l .5s ease-in-out infinite alternate; }
      .horse .arm-r { transform-box: fill-box; transform-origin: 10% 10%; animation: wave-r .5s ease-in-out infinite alternate; }
      .horse .tail  { transform-box: fill-box; transform-origin: 0% 100%; animation: wag .4s ease-in-out infinite alternate; }
      .horse .shine { animation: shine 1.6s linear infinite; }
      @keyframes groove { from { rotate: -10deg; } to { rotate: 10deg; } }
      @keyframes bob    { from { translate: 0 0; rotate: -6deg; } to { translate: 0 -5px; rotate: 6deg; } }
      @keyframes wave-l { from { rotate: 20deg; } to { rotate: -60deg; } }
      @keyframes wave-r { from { rotate: 60deg; } to { rotate: -20deg; } }
      @keyframes wag    { from { rotate: -25deg; } to { rotate: 25deg; } }
      @keyframes shine  { 0%, 60% { translate: -30px 0; opacity: 0; } 70% { opacity: 1; } 100% { translate: 30px 0; opacity: 0; } }

      /* ---- click sparks ---- */
      .spark {
        position: fixed; width: 8px; height: 8px; border-radius: 50%; pointer-events: none;
        background: var(--c); box-shadow: 0 0 10px var(--c), 0 0 20px var(--c);
        animation: burst .9s ease-out forwards;
      }
      @keyframes burst { to { translate: var(--dx) var(--dy); scale: 0; opacity: 0; } }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="stars" id="stars"></div>
    <div class="sun"></div>
    <div class="floor"></div>
    <div class="beam b1"></div>
    <div class="beam b2"></div>
    <div class="beam b3"></div>

    <main class="stage">
      <h1>Hello World</h1>
    </main>

    <div class="bouncer horse" id="horse" aria-hidden="true">
      <svg viewBox="0 0 170 200">
        <g class="dance">
          <!-- tail -->
          <g class="tail">
            <path d="M116 150 q30 -6 36 -44" fill="none" stroke="#3b2314" stroke-width="10" stroke-linecap="round"/>
            <path d="M116 156 q36 2 44 -30" fill="none" stroke="#4a2c18" stroke-width="8" stroke-linecap="round"/>
            <path d="M114 162 q30 10 40 -12" fill="none" stroke="#3b2314" stroke-width="7" stroke-linecap="round"/>
          </g>
          <!-- body and back legs -->
          <rect x="62" y="168" width="14" height="24" rx="5" fill="#a0612f"/>
          <rect x="94" y="168" width="14" height="24" rx="5" fill="#a0612f"/>
          <rect x="60" y="188" width="18" height="9" rx="3" fill="#2b1a10"/>
          <rect x="92" y="188" width="18" height="9" rx="3" fill="#2b1a10"/>
          <ellipse cx="85" cy="145" rx="36" ry="38" fill="#b5703a"/>
          <ellipse cx="85" cy="152" rx="20" ry="25" fill="#d9a066"/>
          <!-- front legs, waving -->
          <g class="arm-l">
            <path d="M54 126 q-22 -6 -30 -30" fill="none" stroke="#b5703a" stroke-width="12" stroke-linecap="round"/>
            <circle cx="24" cy="94" r="7" fill="#2b1a10"/>
          </g>
          <g class="arm-r">
            <path d="M116 126 q22 -6 30 -30" fill="none" stroke="#b5703a" stroke-width="12" stroke-linecap="round"/>
            <circle cx="146" cy="94" r="7" fill="#2b1a10"/>
          </g>
          <g class="head">
            <!-- ears -->
            <polygon points="56,30 60,0 74,24" fill="#b5703a"/>
            <polygon points="114,30 110,0 96,24" fill="#b5703a"/>
            <polygon points="60,26 62,9 70,23" fill="#e8a0b4"/>
            <polygon points="110,26 108,9 100,23" fill="#e8a0b4"/>
            <!-- long face and muzzle -->
            <ellipse cx="85" cy="66" rx="31" ry="46" fill="#b5703a"/>
            <ellipse cx="85" cy="100" rx="27" ry="19" fill="#d9a066"/>
            <ellipse cx="75" cy="100" rx="4" ry="6" fill="#5a2d0c"/>
            <ellipse cx="95" cy="100" rx="4" ry="6" fill="#5a2d0c"/>
            <path d="M74 111 q11 8 22 0" fill="none" stroke="#5a2d0c" stroke-width="3" stroke-linecap="round"/>
            <!-- mane -->
            <path d="M70 26 q15 -18 30 0 q-6 10 -15 12 q-9 -2 -15 -12 z" fill="#3b2314"/>
            <path d="M84 20 q-6 -14 4 -20 q2 12 -4 20 z" fill="#3b2314"/>
            <!-- sunglasses -->
            <rect x="46" y="48" width="36" height="22" rx="8" fill="#111"/>
            <rect x="88" y="48" width="36" height="22" rx="8" fill="#111"/>
            <rect x="80" y="54" width="10" height="5" fill="#111"/>
            <line x1="46" y1="54" x2="40" y2="50" stroke="#111" stroke-width="4"/>
            <line x1="124" y1="54" x2="130" y2="50" stroke="#111" stroke-width="4"/>
            <clipPath id="lenses"><rect x="46" y="48" width="36" height="22" rx="8"/><rect x="88" y="48" width="36" height="22" rx="8"/></clipPath>
            <g clip-path="url(#lenses)"><rect class="shine" x="62" y="36" width="10" height="50" fill="#fff" opacity=".7" transform="skewX(-20)"/></g>
          </g>
        </g>
      </svg>
    </div>

    <script>
      (() => {
        const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches
        const neon = ["#ff2bd6", "#00f0ff", "#b6ff00", "#ffe259", "#ff8c42", "#b400ff"]
        const pick = (list) => list[Math.floor(Math.random() * list.length)]

        // Twinkling stars
        const stars = document.getElementById("stars")
        for (let i = 0; i < 120; i++) {
          const star = document.createElement("div")
          star.className = "star"
          star.style.left = `${Math.random() * 100}%`
          star.style.top = `${Math.random() * 60}%`
          star.style.setProperty("--t", `${1 + Math.random() * 3}s`)
          stars.appendChild(star)
        }

        // Bouncing neon shapes, plus the horse
        const bouncers = []
        const addBouncer = (element, speed) => {
          const angle = Math.random() * Math.PI * 2
          bouncers.push({
            element,
            x: Math.random() * (innerWidth - 120),
            y: Math.random() * (innerHeight - 120),
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
          })
        }
        for (const glyph of ["★", "▲", "●", "◆", "✦", "♥", "⬢", "✚"]) {
          const wrapper = document.createElement("div")
          wrapper.className = "bouncer"
          wrapper.setAttribute("aria-hidden", "true")
          const shape = document.createElement("div")
          shape.className = "shape"
          shape.textContent = glyph
          shape.style.setProperty("--glow", pick(neon))
          wrapper.appendChild(shape)
          document.body.appendChild(wrapper)
          addBouncer(wrapper, 2 + Math.random() * 2.5)
        }
        addBouncer(document.getElementById("horse"), 2.4)

        const tick = () => {
          for (const b of bouncers) {
            const w = b.element.offsetWidth, h = b.element.offsetHeight
            b.x += b.vx
            b.y += b.vy
            let bounced = false
            if (b.x <= 0 || b.x + w >= innerWidth) { b.vx *= -1; b.x = Math.max(0, Math.min(b.x, innerWidth - w)); bounced = true }
            if (b.y <= 0 || b.y + h >= innerHeight) { b.vy *= -1; b.y = Math.max(0, Math.min(b.y, innerHeight - h)); bounced = true }
            if (bounced) {
              const shape = b.element.querySelector(".shape")
              if (shape) shape.style.setProperty("--glow", pick(neon))
            }
            b.element.style.transform = `translate(${b.x}px, ${b.y}px)`
          }
          if (!reduceMotion) requestAnimationFrame(tick)
        }
        tick()

        // Click anywhere for a neon burst
        addEventListener("pointerdown", (event) => {
          if (reduceMotion) return
          for (let i = 0; i < 24; i++) {
            const spark = document.createElement("div")
            spark.className = "spark"
            const angle = (i / 24) * Math.PI * 2
            const distance = 60 + Math.random() * 90
            spark.style.left = `${event.clientX}px`
            spark.style.top = `${event.clientY}px`
            spark.style.setProperty("--c", pick(neon))
            spark.style.setProperty("--dx", `${Math.cos(angle) * distance}px`)
            spark.style.setProperty("--dy", `${Math.sin(angle) * distance}px`)
            document.body.appendChild(spark)
            spark.addEventListener("animationend", () => spark.remove())
          }
        })
      })()
    </script>
  </body>
</html>
