<section class="card overflow-hidden">
  <div class="bg-gradient-to-br from-amber-100 via-amber-50 to-stone-50 px-6 py-10 text-center dark:from-amber-950 dark:via-stone-900 dark:to-stone-900">
    <p class="text-5xl" aria-hidden="true">🐴</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Every ride, logged and shared</h1>
    <p class="mx-auto mt-3 max-w-xl text-stone-600 dark:text-stone-300">
      Trotter is a ride tracker for horses and their riders. Log where you rode and how long it took,
      and see where everyone else has been riding.
    </p>
    <div class="mt-6">
      <%= link_to "Browse the feed", activities_path, class: "btn-primary" %>
    </div>
  </div>
</section>

<section class="mt-10">
  <h2 class="text-xl font-bold">How it works</h2>
  <ol class="mt-4 grid gap-4 sm:grid-cols-3">
    <li class="card p-4">
      <p class="font-semibold">1. Ride</p>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300">Head out on the trail, around the farm, or into the arena.</p>
    </li>
    <li class="card p-4">
      <p class="font-semibold">2. Log it</p>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300">Trotter works out your distance, time, and pace.</p>
    </li>
    <li class="card p-4">
      <p class="font-semibold">3. Share it</p>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300">
        Your ride shows up in the <%= link_to "feed", activities_path, class: "text-amber-800 underline dark:text-amber-400" %> for everyone to see.
      </p>
    </li>
  </ol>
</section>

<section class="mt-10">
  <div class="flex items-baseline justify-between">
    <h2 class="text-xl font-bold">Recent rides</h2>
    <%= link_to "See all rides →", activities_path, class: "text-sm font-medium text-amber-800 hover:underline dark:text-amber-400" %>
  </div>

  <% if @recent_activities.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-stone-300 px-4 py-10 text-center text-stone-500 dark:border-stone-700 dark:text-stone-400">
      No rides yet.
    </p>
  <% else %>
    <div class="mt-4 space-y-4">
      <%= render @recent_activities %>
    </div>
  <% end %>
</section>
