<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Trotter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Trotter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 text-stone-900 dark:bg-stone-950 dark:text-stone-100">
    <header class="border-b border-stone-200 bg-white dark:border-stone-800 dark:bg-stone-900">
      <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to "🐴 Trotter", root_path, class: "text-xl font-bold tracking-tight text-amber-800 dark:text-amber-500" %>

        <div class="flex items-center gap-4 text-sm font-medium">
          <%= link_to "Home", root_path, class: "text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-white" %>
          <%= link_to "Feed", activities_path, class: "text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-white" %>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-stone-200 bg-white dark:border-stone-800 dark:bg-stone-900">
      <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-6 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between dark:text-stone-400">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2">
          <%= link_to "Home", root_path, class: "hover:text-stone-900 dark:hover:text-white" %>
          <%= link_to "Feed", activities_path, class: "hover:text-stone-900 dark:hover:text-white" %>
          <%= link_to "GitHub", "https://github.com/lquainta/trotter", class: "hover:text-stone-900 dark:hover:text-white" %>
        </nav>
        <p>&copy; <%= Date.current.year %> Trotter</p>
      </div>
    </footer>
  </body>
</html>
