<% content_for :title, "#{@activity.title} · Trotter" %>

<article id="<%= dom_id(@activity) %>">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <%= link_to user_path(@activity.user), class: "rounded-full" do %>
        <%= avatar_for @activity.user %>
        <span class="sr-only"><%= @activity.user.username %>'s profile</span>
      <% end %>
      <div>
        <h1 class="text-2xl font-bold"><%= @activity.title %></h1>
        <p class="text-sm text-stone-500 dark:text-stone-400">
          <%= link_to @activity.user.username, user_path(@activity.user), class: "font-semibold text-stone-700 hover:underline dark:text-stone-200" %>
          &middot; <%= @activity.started_at.strftime("%A, %B %-d, %Y at %-l:%M %p") %>
        </p>
      </div>
    </div>

    <% if @activity.user == Current.user %>
      <div class="flex items-center gap-2">
        <%= link_to "Edit", edit_activity_path(@activity), class: "btn-secondary" %>
        <%= button_to "Delete", activity_path(@activity), method: :delete,
              class: "btn-secondary text-red-700 dark:text-red-400",
              form: { data: { turbo_confirm: "Delete \"#{@activity.title}\" and its photos? This can't be undone." } } %>
      </div>
    <% end %>
  </div>

  <section class="card mt-6 p-4">
    <%= render "activities/stats", activity: @activity, size: "text-xl font-semibold" %>
  </section>

  <% if @activity.route_coordinates.present? %>
    <div data-controller="route-map" data-route-map-points-value="<%= @activity.route_coordinates.to_json %>"
         data-route-map-interactive-value="true"
         role="region" aria-label="Map of the route for <%= @activity.title %>"
         class="isolate mt-6 h-96 rounded-lg border border-stone-200 sm:h-[32rem] dark:border-stone-800"></div>
  <% end %>

  <% if @activity.description.present? %>
    <section class="mt-6">
      <h2 class="sr-only">Description</h2>
      <p class="whitespace-pre-line text-stone-700 dark:text-stone-300"><%= @activity.description %></p>
    </section>
  <% end %>

  <section id="photos" class="mt-8">
    <h2 class="text-lg font-semibold">Photos</h2>
    <% if @activity.photos.attached? %>
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% @activity.photos.each_with_index do |photo, index| %>
          <li>
            <%= link_to rails_representation_path(photo.variant(:full)), target: "_blank", rel: "noopener",
                  title: "Open photo #{index + 1} full size" do %>
              <%= image_tag photo.variant(:preview), alt: "Photo #{index + 1} from #{@activity.title}", loading: "lazy",
                    class: "aspect-[4/3] w-full rounded-md border border-stone-200 object-cover transition hover:opacity-90 dark:border-stone-800" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-stone-300 px-4 py-8 text-center text-stone-500 dark:border-stone-700 dark:text-stone-400">
        No photos from this ride.
        <% if @activity.user == Current.user %>
          <%= link_to "Add some", edit_activity_path(@activity), class: "text-amber-800 underline dark:text-amber-400" %>.
        <% end %>
      </p>
    <% end %>
  </section>

  <p class="mt-8"><%= link_to "← Back to the feed", activities_path, class: "text-sm font-medium text-amber-800 hover:underline dark:text-amber-400" %></p>
</article>
