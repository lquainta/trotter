<% content_for :title, "Edit #{@activity.title_was} · Trotter" %>

<h1 class="text-2xl font-bold">Edit ride</h1>
<p class="mt-1 text-stone-600 dark:text-stone-300">Change any detail, redraw the route, or add and remove photos.</p>

<%= render "form", activity: @activity %>

<section class="card mt-6 border-red-200 p-6 dark:border-red-900">
  <h2 class="text-lg font-semibold">Delete this ride</h2>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-300">The ride and its photos are deleted for good. This can't be undone.</p>
  <%= button_to "Delete ride", activity_path(@activity), method: :delete, class: "btn-danger mt-4",
        form: { data: { turbo_confirm: "Delete \"#{@activity.title_was}\" and its photos? This can't be undone." } } %>
</section>
