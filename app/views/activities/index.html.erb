<% content_for :title, "Feed · Trotter" %>

<h1 class="text-2xl font-bold">Feed</h1>
<p class="mt-1 text-stone-600 dark:text-stone-300">Everyone's rides, newest first.</p>

<% if @activities.empty? %>
  <p class="mt-6 rounded-lg border border-dashed border-stone-300 px-4 py-10 text-center text-stone-500 dark:border-stone-700 dark:text-stone-400">
    No rides yet.
  </p>
<% else %>
  <div class="mt-6 space-y-4">
    <%= render @activities %>
  </div>
<% end %>
