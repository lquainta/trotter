<article id="<%= dom_id(activity) %>" class="card overflow-hidden">
  <div class="flex items-center gap-3 px-4 pt-4">
    <%= link_to user_path(activity.user), tabindex: -1 do %>
      <%= avatar_for activity.user %>
    <% end %>
    <div class="min-w-0">
      <%= link_to activity.user.username, user_path(activity.user), class: "font-semibold hover:underline" %>
      <p class="text-xs text-stone-500 dark:text-stone-400"><%= format_start_time(activity.started_at) %></p>
    </div>
  </div>

  <div class="px-4 pt-3 pb-4">
    <h2 class="text-lg font-semibold"><%= activity.title %></h2>
    <% if activity.description.present? %>
      <p class="mt-1 whitespace-pre-line text-stone-600 dark:text-stone-300"><%= activity.description %></p>
    <% end %>

    <dl class="mt-3 grid grid-cols-2 gap-y-3 sm:grid-cols-4">
      <% { "Distance" => format_distance(activity.distance_meters),
           "Time" => format_duration(activity.duration),
           "Avg pace" => format_pace(activity.distance_meters, activity.duration),
           "Avg speed" => format_speed(activity.distance_meters, activity.duration) }.each do |label, value| %>
        <div>
          <dt class="text-xs text-stone-500 dark:text-stone-400"><%= label %></dt>
          <dd class="text-lg font-semibold tabular-nums"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <% if activity.route_coordinates.any? %>
    <div class="feed-map h-64 w-full z-0" data-route="<%= activity.route_coordinates.to_json %>"></div>
  <% end %>

  <% if activity.photos.attached? %>
    <div class="grid gap-1 p-1 <%= { 1 => "grid-cols-1", 2 => "grid-cols-2" }.fetch(activity.photos.size, "grid-cols-3") %>">
      <% activity.photos.each do |photo| %>
        <%= link_to url_for(photo.variant(:full)), target: "_blank", rel: "noopener" do %>
          <%= image_tag photo.variant(:preview), alt: "Photo from #{activity.title}", loading: "lazy",
                class: "w-full object-cover #{activity.photos.size == 1 ? "aspect-video" : "aspect-square"}" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</article>
