<article id="<%= dom_id(activity) %>" class="card p-4">
  <p class="text-sm text-stone-500 dark:text-stone-400">
    <%= link_to activity.user.username, user_path(activity.user), class: "font-semibold text-stone-700 hover:underline dark:text-stone-200" %>
    &middot; <%= activity.started_at.strftime("%B %-d, %Y at %-l:%M %p") %>
    <% if activity.horse %>
      &middot; on <%= link_to activity.horse.name, horse_path(activity.horse), class: "font-semibold text-amber-800 hover:underline dark:text-amber-400" %>
    <% end %>
  </p>
  <h2 class="mt-1 text-lg font-semibold"><%= link_to activity.title, activity_path(activity), class: "hover:underline" %></h2>
  <% if activity.description.present? %>
    <p class="mt-1 text-stone-600 dark:text-stone-300"><%= activity.description %></p>
  <% end %>

  <div class="mt-3"><%= render "activities/stats", activity: activity %></div>

  <% if activity.route_coordinates.present? %>
    <div data-controller="route-map" data-route-map-points-value="<%= activity.route_coordinates.to_json %>"
         role="img" aria-label="Map of the route for <%= activity.title %>"
         class="isolate mt-4 h-48 rounded-md border border-stone-200 sm:h-56 dark:border-stone-800"></div>
  <% end %>

  <% if activity.photos.attached? %>
    <% shown = activity.photos.first(4) %>
    <ul class="mt-3 grid grid-cols-4 gap-2" aria-label="Photos">
      <% shown.each_with_index do |photo, index| %>
        <li class="relative">
          <%= link_to activity_path(activity, anchor: "photos") do %>
            <%= image_tag photo.variant(:thumb), alt: "Photo from #{activity.title}", loading: "lazy",
                  class: "aspect-square w-full rounded-md object-cover" %>
            <% if index == shown.size - 1 && activity.photos.size > shown.size %>
              <span class="absolute inset-0 flex items-center justify-center rounded-md bg-black/50 text-lg font-semibold text-white">
                +<%= activity.photos.size - shown.size %>
              </span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</article>
