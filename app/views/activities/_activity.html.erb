<article id="<%= dom_id(activity) %>" class="card p-4">
  <p class="text-sm text-stone-500 dark:text-stone-400">
    <%= link_to activity.user.username, user_path(activity.user), class: "font-semibold text-stone-700 hover:underline dark:text-stone-200" %>
    &middot; <%= activity.started_at.strftime("%B %-d, %Y at %-l:%M %p") %>
  </p>
  <h2 class="mt-1 text-lg font-semibold"><%= activity.title %></h2>
  <% if activity.description.present? %>
    <p class="mt-1 text-stone-600 dark:text-stone-300"><%= activity.description %></p>
  <% end %>

  <dl class="mt-3 grid grid-cols-3 gap-2">
    <% { "Distance" => format_distance(activity.distance_meters), "Time" => format_duration(activity.duration),
         "Pace" => format_pace(activity.distance_meters, activity.duration) }.each do |label, value| %>
      <div>
        <dt class="text-xs text-stone-500 uppercase dark:text-stone-400"><%= label %></dt>
        <dd class="font-semibold"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</article>
